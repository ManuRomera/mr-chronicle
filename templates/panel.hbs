<div class="mrc-principal">
  {{#if problema}}
  <div class="mrc-aviso rojo">
    <p>{{problema}}</p>
    {{#if sinHttps}}
    <p><strong>¿Foundry está en este mismo ordenador?</strong> Ábrelo por <a href="{{sinHttps.local}}">{{sinHttps.local}}</a> y podrás grabar.</p>
    <p><strong>¿Jugáis desde casas distintas?</strong> Quien tiene Foundry abre <em>Compartir Foundry</em> (en las herramientas de MR · Chronicle): da gratis una dirección <code>https://…trycloudflare.com</code> para todos. <a href="https://github.com/ManuRomera/mr-chronicle#foundry-en-casa-https-gratis-con-un-túnel" target="_blank" rel="noopener">Cómo se hace</a>.</p>
    {{/if}}
  </div>
  {{/if}}

  {{! ─── Sesión ─── }}
  <section class="mrc-bloque">
    {{#if s}}
    <header>
      <h2>{{s.nombre}}</h2>
      <p class="mrc-fase" data-fase="{{s.fase}}">{{faseTexto}}</p>
    </header>
    {{else}}
    <header><h2>Sin sesión</h2></header>
    {{/if}}

    {{#if esGM}}
      {{#unless s}}
      <label class="mrc-campo">Nombre de la sesión
        <input type="text" name="nombre" placeholder="Curse of Strahd 26">
      </label>
      <fieldset class="mrc-canales">
        <legend>Pistas de Foundry que se grabarán</legend>
        {{#each canales}}<label class="mrc-check"><input type="checkbox" name="canal-{{id}}" {{checked marcado}}> {{nombre}}</label>{{/each}}
        <p class="mrc-nota">Lo que no marques no se graba, no se entrega y no se procesa. Tu voz se graba aparte, si aceptas más abajo.</p>
      </fieldset>
      <div class="mrc-botones"><button type="button" data-action="preparar" class="mrc-principal-btn">Preparar sesión</button></div>
      {{else}}
      <div class="mrc-botones">
        {{#if (eq fase "preparada")}}<button type="button" data-action="fase" data-fase="grabando" class="mrc-principal-btn" {{disabled consentimientos.nadie}}>● Iniciar grabación</button>{{/if}}
        {{#if (eq fase "grabando")}}<button type="button" data-action="fase" data-fase="pausada">❚❚ Pausar a todos</button>{{/if}}
        {{#if (eq fase "pausada")}}<button type="button" data-action="fase" data-fase="grabando" class="mrc-principal-btn">▶ Reanudar a todos</button>{{/if}}
        {{#if grabable}}{{#unless (eq fase "preparada")}}<button type="button" data-action="fase" data-fase="finalizada">■ Finalizar</button>{{/unless}}{{/if}}
        {{#if (or finalizada (eq fase "preparada"))}}<button type="button" data-action="cerrarSesion">Cerrar sesión</button>{{/if}}
      </div>
      {{#if (or (eq fase "grabando") (eq fase "pausada"))}}
      <p class="mrc-nota">Pistas de Foundry: {{#if canalesElegidos}}{{canalesElegidos}}{{else}}ninguna{{/if}}.</p>
      {{/if}}
      {{#if (eq fase "preparada")}}
      <fieldset class="mrc-canales">
        <legend>Pistas de Foundry que se grabarán</legend>
        {{#each canales}}<label class="mrc-check"><input type="checkbox" name="canal-{{id}}" {{checked marcado}}> {{nombre}}</label>{{/each}}
        <p class="mrc-nota">Lo que no marques no se graba, no se entrega y no se procesa. Tu voz se graba aparte, si aceptas más abajo.</p>
      </fieldset>
      <p class="mrc-nota">{{#if consentimientos.nadie}}Nadie ha aceptado todavía: cada participante tiene que aceptar en su panel antes de iniciar.{{else}}Han aceptado {{consentimientos.aceptados}} de {{consentimientos.activos}}.{{#unless consentimientos.todos}} A quien no acepte no se le grabará.{{/unless}}{{/if}}</p>
      {{/if}}
      {{/unless}}
    {{/if}}
  </section>

  {{! ─── Tu grabación ─── }}
  {{#if grabable}}{{#unless problema}}
  <section class="mrc-bloque">
    <h3>Tu grabación</h3>
    {{#if yo.grabando}}
      <p class="mrc-grande">{{#if yo.pausa}}❚❚ En pausa{{else}}<span class="mrc-punto"></span> Grabando{{/if}} · <span data-mrc-reloj>{{reloj}}</span></p>
      <p class="mrc-nota" data-mrc-guardado>{{yo.guardadoMB}} MB guardados en este ordenador</p>
      <div class="mrc-nivel"><span></span></div>
      <p class="mrc-micro" data-mrc-micro></p>
      <label class="mrc-campo">Marcador (opcional)
        <input type="text" name="marcador" placeholder="Momento para el tráiler">
      </label>
      <div class="mrc-botones">
        <button type="button" data-action="marcar" data-tipo="momento">★ Marcar momento</button>
        <button type="button" data-action="marcar" data-tipo="cortar">✂ Cortar esto</button>
        {{#if yo.pausa}}
        <button type="button" data-action="pausarMia" data-valor="0">▶ Reanudar mi micro</button>
        {{else}}
        <button type="button" data-action="pausarMia" data-valor="1">❚❚ Pausar mi micro</button>
        {{/if}}
      </div>
      <p class="mrc-nota">«Cortar esto» avisa al editor para que quite ese momento antes de publicar. Mientras tu micro está en pausa se graba silencio.</p>
      <button type="button" data-action="retirar" class="mrc-enlace">Retirar mi consentimiento y dejar de grabar</button>
    {{else}}
      <p class="mrc-nota">Solo se graba <strong>tu micrófono</strong>, en tu navegador. No sale de tu ordenador hasta que lo entregas. Usa <strong>cascos</strong>: con altavoces tu micro recogería a los demás.</p>
      <label class="mrc-campo">Micrófono
        <select name="micro">
          {{#each micros}}<option value="{{id}}" {{#if elegido}}selected{{/if}}>{{nombre}}</option>{{else}}<option value="">Micrófono predeterminado</option>{{/each}}
        </select>
      </label>
      <div class="mrc-nivel"><span></span></div>
      <p class="mrc-micro" data-mrc-micro></p>
      <label class="mrc-check"><input type="checkbox" name="grabar" {{checked yo.acepta}}> Acepto que se grabe mi voz en esta sesión</label>
      <label class="mrc-check"><input type="checkbox" name="publicar" {{checked yo.publica}}> Acepto que se publique en el podcast</label>
      <div class="mrc-botones">
        <button type="button" data-action="probar">Probar micro</button>
        <button type="button" data-action="aceptar" class="mrc-principal-btn">Guardar</button>
      </div>
      {{#if yo.acepta}}<p class="mrc-nota">Listo. No tienes que pulsar nada más: cuando el máster inicie, verás una cuenta atrás y empezarás a grabar a la vez que los demás.</p>{{else}}<p class="mrc-nota">Marca lo que aceptas y pulsa <strong>Guardar</strong>. Es el máster quien inicia la grabación.</p>{{/if}}
    {{/if}}
    {{#if pocoEspacio}}<p class="mrc-aviso ambar">Queda poco espacio para grabar ({{libreGB}} GB). Cuatro horas ocupan unos 1,4 GB.</p>{{/if}}
    {{#if yo.error}}<p class="mrc-aviso rojo">{{yo.error}}</p>{{/if}}
  </section>
  {{/unless}}{{/if}}

  {{! ─── Entrega ─── }}
  {{#if finalizada}}{{#if actual}}
  <section class="mrc-bloque">
    <h3>Guarda y entrega tu grabación</h3>
    {{#if direccionCambiante}}<p class="mrc-aviso ambar"><strong>Guarda la copia ahora.</strong> Esta dirección (túnel) cambia la próxima vez, y el navegador solo te enseña la grabación desde la dirección en la que se hizo.</p>{{/if}}
    {{#if entrega}}{{#if (eq entrega.sesionId s.id)}}
      <div class="mrc-progreso"><span style="width: {{entrega.porcentaje}}%"></span></div>
      <p class="mrc-nota">{{entrega.hechos}} de {{entrega.total}} archivos</p>
      {{#if entrega.error}}<p class="mrc-aviso rojo">{{entrega.error}}</p>{{/if}}
      {{#if (eq entrega.fin "zip")}}<p class="mrc-aviso verde">Copia guardada. Súbela a la carpeta compartida del grupo (Drive, MEGA…) o pásasela a quien vaya a procesar.</p>{{/if}}
      {{#if (eq entrega.fin "subir")}}<p class="mrc-aviso verde">¡Entregada! Está en el servidor y se ha comprobado el tamaño de cada archivo.</p>{{/if}}
    {{/if}}{{/if}}
    {{#unless entrega.enCurso}}
    <p class="mrc-nota"><strong>Guardar copia (.zip)</strong> crea un único archivo con tu grabación ({{actual.mb}} MB). Súbelo a la carpeta compartida del grupo: quien procese la sesión lo usa tal cual, sin descomprimirlo.</p>
    <div class="mrc-botones">
      <button type="button" data-action="entregar" data-modo="zip" class="mrc-principal-btn">Guardar copia (.zip)</button>
      <button type="button" data-action="entregar" data-modo="subir" {{disabled (not puedeSubir)}}>Entregar al servidor</button>
    </div>
    {{#unless puedeSubir}}<p class="mrc-nota">Para «Entregar al servidor», el máster tiene que activar Subir archivos para tu rol en Configurar permisos.</p>{{/unless}}
    {{#if (or actual.guardada actual.subida)}}<button type="button" data-action="borrarLocal" class="mrc-enlace">Borrar la grabación de este navegador</button>{{/if}}
    {{/unless}}
  </section>
  {{/if}}{{/if}}

  {{! ─── Otras grabaciones guardadas en este navegador ─── }}
  {{#if otras.length}}
  <section class="mrc-bloque">
    <h3>Grabaciones en este navegador</h3>
    <p class="mrc-nota">De sesiones anteriores o ya cerradas. Guarda la copia de las que falten por entregar.</p>
    {{#if entrega.error}}{{#unless (eq entrega.sesionId s.id)}}<p class="mrc-aviso rojo">{{entrega.error}}</p>{{/unless}}{{/if}}
    <ul class="mrc-biblioteca">
      {{#each otras}}
      <li>
        <span class="mrc-nombre">{{nombre}}</span>
        <span class="mrc-texto">{{mb}} MB · {{#if guardada}}copia guardada{{else}}{{#if subida}}entregada{{else}}<strong>sin guardar</strong>{{/if}}{{/if}}</span>
        <span class="mrc-botones">
          <button type="button" data-action="entregar" data-modo="zip" data-sesion="{{sesionId}}">Guardar copia</button>
          {{#if (or guardada subida)}}<button type="button" data-action="borrarLocal" data-sesion="{{sesionId}}">Borrar</button>{{/if}}
        </span>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
</div>
